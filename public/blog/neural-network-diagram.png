<svg width="600" height="300" viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg">
  <rect width="600" height="300" fill="#1a1a2e"/>
  
  <!-- Detailed neural network diagram -->
  <g transform="translate(50, 50)">
    <!-- Input layer -->
    <text x="25" y="20" text-anchor="middle" fill="#e0e0e0" font-family="Arial, sans-serif" font-size="12">Input</text>
    <circle cx="25" cy="50" r="10" fill="#3a388e" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="25" cy="80" r="10" fill="#3a388e" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="25" cy="110" r="10" fill="#3a388e" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="25" cy="140" r="10" fill="#3a388e" stroke="#e0e0e0" stroke-width="1"/>
    
    <!-- Hidden layer 1 -->
    <text x="150" y="20" text-anchor="middle" fill="#e0e0e0" font-family="Arial, sans-serif" font-size="12">Hidden 1</text>
    <circle cx="150" cy="40" r="10" fill="#8d2f6a" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="150" cy="70" r="10" fill="#8d2f6a" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="150" cy="100" r="10" fill="#8d2f6a" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="150" cy="130" r="10" fill="#8d2f6a" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="150" cy="160" r="10" fill="#8d2f6a" stroke="#e0e0e0" stroke-width="1"/>
    
    <!-- Hidden layer 2 -->
    <text x="275" y="20" text-anchor="middle" fill="#e0e0e0" font-family="Arial, sans-serif" font-size="12">Hidden 2</text>
    <circle cx="275" cy="60" r="10" fill="#4b4abd" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="275" cy="90" r="10" fill="#4b4abd" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="275" cy="120" r="10" fill="#4b4abd" stroke="#e0e0e0" stroke-width="1"/>
    
    <!-- Output layer -->
    <text x="400" y="20" text-anchor="middle" fill="#e0e0e0" font-family="Arial, sans-serif" font-size="12">Output</text>
    <circle cx="400" cy="70" r="10" fill="#3a388e" stroke="#e0e0e0" stroke-width="1"/>
    <circle cx="400" cy="110" r="10" fill="#3a388e" stroke="#e0e0e0" stroke-width="1"/>
    
    <!-- Connections -->
    <line x1="35" y1="50" x2="140" y2="40" stroke="rgba(224,224,224,0.3)" stroke-width="1"/>
    <line x1="35" y1="80" x2="140" y2="70" stroke="rgba(224,224,224,0.3)" stroke-width="1"/>
    <line x1="160" y1="70" x2="265" y2="60" stroke="rgba(224,224,224,0.3)" stroke-width="1"/>
    <line x1="285" y1="90" x2="390" y2="70" stroke="rgba(224,224,224,0.3)" stroke-width="1"/>
  </g>
</svg>