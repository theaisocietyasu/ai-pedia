<svg width="800" height="400" viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4b4abd;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3a388e;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="#0b0a10"/>
  <rect width="800" height="400" fill="url(#grad5)" opacity="0.3"/>
  
  <!-- TensorFlow logo placeholder -->
  <g transform="translate(300, 150)">
    <rect x="0" y="0" width="200" height="100" fill="#8d2f6a" opacity="0.6" rx="10"/>
    <text x="100" y="40" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="16" font-weight="bold">TensorFlow</text>
    <text x="100" y="65" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="12">Tutorial</text>
  </g>
  
  <!-- Code blocks -->
  <rect x="100" y="100" width="150" height="80" fill="rgba(255,255,255,0.1)" rx="5"/>
  <rect x="550" y="220" width="150" height="80" fill="rgba(255,255,255,0.1)" rx="5"/>
  
  <text x="400" y="350" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="24" font-weight="bold">TensorFlow Tutorial</text>
</svg>