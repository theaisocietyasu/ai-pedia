<svg width="800" height="400" viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3a388e;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#8d2f6a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4b4abd;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="#0b0a10"/>
  <rect width="800" height="400" fill="url(#grad1)" opacity="0.3"/>
  
  <!-- Neural network visualization -->
  <g transform="translate(100, 100)">
    <!-- Input layer -->
    <circle cx="50" cy="50" r="15" fill="#3a388e" opacity="0.8"/>
    <circle cx="50" cy="100" r="15" fill="#3a388e" opacity="0.8"/>
    <circle cx="50" cy="150" r="15" fill="#3a388e" opacity="0.8"/>
    
    <!-- Hidden layer -->
    <circle cx="200" cy="30" r="12" fill="#8d2f6a" opacity="0.8"/>
    <circle cx="200" cy="70" r="12" fill="#8d2f6a" opacity="0.8"/>
    <circle cx="200" cy="110" r="12" fill="#8d2f6a" opacity="0.8"/>
    <circle cx="200" cy="150" r="12" fill="#8d2f6a" opacity="0.8"/>
    <circle cx="200" cy="190" r="12" fill="#8d2f6a" opacity="0.8"/>
    
    <!-- Output layer -->
    <circle cx="350" cy="75" r="15" fill="#4b4abd" opacity="0.8"/>
    <circle cx="350" cy="125" r="15" fill="#4b4abd" opacity="0.8"/>
    
    <!-- Connections -->
    <line x1="65" y1="50" x2="185" y2="30" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
    <line x1="65" y1="50" x2="185" y2="70" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
    <line x1="65" y1="100" x2="185" y2="110" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
    <line x1="212" y1="70" x2="335" y2="75" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
    <line x1="212" y1="110" x2="335" y2="125" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
  </g>
  
  <text x="400" y="350" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="24" font-weight="bold">Neural Networks</text>
</svg>